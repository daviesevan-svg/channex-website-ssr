{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deliberately NOT "channex-website-live" so test deploys can never
  // overwrite the Worker that may be serving production channex.io.
  // Rename when cutting over for real.
  "name": "channex-website-ssr",
  "compatibility_date": "2026-05-28",
  "main": "./workers/app.ts",
  // Explicit so deploys don't warn about defaulting these on.
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  // Stores contact-form enquiries so a Resend outage can't lose a lead (see
  // app/lib/contact.server.ts). The database_id is an identifier, not a secret
  // — reading it still requires account auth.
  //
  // Note there is no "vars" block here on purpose: every key in `vars` is
  // re-applied on deploy and would overwrite a dashboard secret of the same
  // name. RESEND_API_KEY must stay a dashboard Secret.
  "d1_databases": [
    { "binding": "DB", "database_name": "channex-website", "database_id": "20098ac7-7b2e-4768-95b1-43dd4d3936f5" }
  ],
  // Daily quarantine digest (workers/app.ts scheduled -> app/lib/digest.server.ts).
  // 07:00 UTC, so it lands before the working day. Nothing is sent on a day
  // with nothing held back.
  "triggers": {
    "crons": ["0 7 * * *"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
